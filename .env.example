# Server only. Copy to .env locally; never commit real values.
NODE_ENV=development
PORT=4600
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://salesflow_app:replace-me@localhost:55481/salesflow
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_DB_PASSWORD=replace-with-another-long-random-password
ORIGIN_SECRET=replace-for-production-private-gateway
AUTOMATION_SECRET=replace-with-a-long-random-secret
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
N8N_WEBHOOK_URL=http://n8n:5678/webhook/salesflow-won
# Telegram credentials belong in the private n8n credential store, not Vite.
# No VITE_ secret variables; frontend uses the same-origin /api endpoint.
