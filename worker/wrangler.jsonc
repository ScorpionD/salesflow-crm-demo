{
  "name": "salesflow-crm-gateway",
  "main": "index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://salesflow-crm-demo-7id.pages.dev",
  },
  "ratelimits": [
    {
      "name": "EDGE_RATE",
      "namespace_id": "810281",
      "simple": {
        "limit": 180,
        "period": 60,
      },
    },
  ],
  "vpc_services": [
    {
      "binding": "PRIVATE_API",
      "service_id": "01a09f8f-9bf9-7613-8aaa-8adb721776aa",
    },
  ],
}
